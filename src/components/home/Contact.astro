---
import {Icon} from 'astro-icon/components';
---

<section id="contacto" class="w-full bg-[#0f0f0f] py-20 px-6 font-sans text-gray-300">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16">

    <div class="flex flex-col justify-between">
      <div>
        <p class="text-xs tracking-widest text-gray-500 uppercase mb-4">03 / Comunicación</p>
        <h2 class="text-5xl md:text-6xl font-serif text-white mb-6">Contacto</h2>
        <p class="text-lg text-gray-400 max-w-md mb-12 leading-relaxed">
          ¿Eres proveedor y quieres colaborar? Escríbeme directamente o agenda una conversación.
        </p>

        <div class="flex flex-col gap-4 max-w-md">
          
          <div class="bg-[#141414] border border-white/5 p-4 rounded flex items-center justify-between group hover:border-[#d4c4a8]/30 transition-colors">
            <div class="flex items-center gap-4">
              <div class="p-2 bg-[#1a1a1a] rounded text-[#d4c4a8]">
                <Icon name="lucide:at-sign" class="w-5 h-5" />
              </div>
              <div>
                <p class="text-[10px] tracking-widest text-gray-500 uppercase">Email</p>
                <p class="text-sm text-white">idaisel@igaimportaciones.com</p>
              </div>
            </div>
            <a href="mailto:>idaisel@igaimportaciones.com<" class="bg-[#1a1a1a] px-4 py-2 text-[10px] tracking-widest uppercase text-white rounded hover:bg-[#d4c4a8] hover:text-black transition-colors">
              Enviar Email
            </a>
          </div>

          <div class="bg-[#141414] border border-white/5 p-4 rounded flex items-center justify-between group hover:border-[#d4c4a8]/30 transition-colors">
            <div class="flex items-center gap-4">
              <div class="p-2 bg-[#1a1a1a] rounded text-[#d4c4a8]">
                <Icon name="lucide:message-square" class="w-5 h-5" />
              </div>
              <div>
                <p class="text-[10px] tracking-widest text-gray-500 uppercase">WhatsApp</p>
                <p class="text-sm text-white">+01 305 690 2553</p>
              </div>
            </div>
            <a href="https://wa.me/013056902553" target="_blank" rel="noopener noreferrer" class="bg-[#1a1a1a] px-4 py-2 text-[10px] tracking-widest uppercase text-white rounded hover:bg-[#d4c4a8] hover:text-black transition-colors">
              Escribir por WhatsApp
            </a>
          </div>

        </div>
      </div>

      <p class="text-sm text-gray-500 mt-16 lg:mt-0">
        Revisión directa de portafolios y catálogos en un plazo máximo de 24 horas hábiles.
      </p>
    </div>

    <div class="bg-[#1a1a1a] p-8 md:p-10 rounded-lg border border-white/5 shadow-2xl">
      <form class="flex flex-col gap-6">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label for="nombre" class="text-[10px] tracking-widest uppercase text-gray-400 font-semibold">Nombre / Empresa</label>
            <input type="text" id="nombre" placeholder="Ej. Distribuidora Central" class="bg-[#141414] border border-white/5 rounded p-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-[#d4c4a8] transition-colors" required>
          </div>
          <div class="flex flex-col gap-2">
            <label for="email" class="text-[10px] tracking-widest uppercase text-gray-400 font-semibold">Correo Electrónico</label>
            <input type="email" id="email" placeholder="proveedor@empresa.com" class="bg-[#141414] border border-white/5 rounded p-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-[#d4c4a8] transition-colors" required>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="rubro" class="text-[10px] tracking-widest uppercase text-gray-400 font-semibold">Tipo de Producto / Rubro</label>
          <input type="text" id="rubro" placeholder="Ej. Textiles, acabados, equipamiento, insumos..." class="bg-[#141414] border border-white/5 rounded p-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-[#d4c4a8] transition-colors" required>
        </div>

        <div class="flex flex-col gap-2">
          <label for="mensaje" class="text-[10px] tracking-widest uppercase text-gray-400 font-semibold">Mensaje o Detalles de Catálogo</label>
          <textarea id="mensaje" rows="5" placeholder="Detalla volúmenes mínimos, plazos promedio y catálogo disponible..." class="bg-[#141414] border border-white/5 rounded p-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-[#d4c4a8] transition-colors resize-none" required></textarea>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-4">
          <button type="submit" class="w-full sm:w-auto bg-[#d4c4a8] text-[#1a1a1a] px-8 py-4 text-xs font-bold tracking-widest uppercase rounded hover:bg-[#c4b498] transition-colors flex items-center justify-center gap-2 group">
            Enviar Mensaje
            <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </button>
          
          <p class="text-[10px] tracking-widest uppercase text-gray-500">
            Privacidad Estricta B2B
          </p>
        </div>

      </form>
    </div>

  </div>
</section>
