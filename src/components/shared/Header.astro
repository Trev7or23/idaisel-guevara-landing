---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '@i18n/utils';

const lang = Astro.currentLocale as 'es' | 'en';
const t = useTranslations(lang);
---
<header class="w-full bg-surface-container-lowest px-6 py-4 flex items-center justify-between font-sans">
  
  <div class="shrink-0">
    <a href="/" class="text-on-surface text-xl md:text-2xl font-serif tracking-wide hover:opacity-80 transition-opacity">
      {t('header.title')}  
    </a>
  </div>

  <div class="flex items-center gap-4">
   
    <div class="bg-surface-container-low p-1 rounded-full flex items-center border border-on-surface/5">
      <button class="px-3 py-1 text-xs font-semibold rounded-full bg-primary-container text-on-primary-container transition-colors">
        ES
      </button>
      <button class="px-3 py-1 text-xs font-semibold rounded-full text-on-surface-variant hover:text-on-surface transition-colors">
        EN
      </button>
    </div>

    <button class="bg-primary-container p-2 rounded-xl hover:bg-primary transition-colors group">
      <Icon name="lucide:user" class="w-5 h-5 text-on-primary-container" />
    </button>

  </div>
</header>
